{
  "manifest_version": 3,
  "name": "BC Report Checker",
  "version": "1.1.7",
  "icons": {
    "16": "icon16.png",
    "32": "icon32.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://bot-config.erp-admin.workers.dev/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://ovcharovols.isystems.cloud:41118/OVCHAROVO/*"
      ],
      "js": [
        "version-guard.js",
        "content.js",
        "store-status.js",
        "store-manager.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
